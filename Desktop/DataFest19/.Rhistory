my_tracts <- get_acs(
state = "MA",
geography = "tract",
variables = c("B01003_001", "B19301_001"),
geometry = TRUE,
keep_geo_vars = TRUE
) %>%
filter(COUNTYFP == "015") %>%
st_transform(4326) %>%
mutate(var_name = ifelse(variable == "B01003_001", "Popluation", "Income"))
color_palette <- c("purple", "blue", "green", "yellow")
ggplot(my_tracts, aes(fill = estimate)) +
geom_sf() +
# scale_fill_gradientn(colours = color_palette) +
scale_fill_continuous(type = "viridis") +
# scale_fill_gradient2(breaks = c(10000, 20000, 30000, 40000), low = "purple", mid = "green", high = "yellow", midpoint = 25000) +
facet_grid(~var_name)
ggplot(my_tracts, aes(fill = estimate)) +
geom_sf() +
scale_fill_continuous(type = "viridis") +
facet_grid(~var_name) +
labs(title = "Population and Median Income in Western Massachusetts Census tracts", caption = "Source: 2016 American Community Survey")
